{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vectors",
  "version": "0.0.1",
  "identifier": "io.github.hieudoan.vectors",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter @vectors/web dev",
    "beforeBuildCommand": "pnpm --filter @vectors/web build"
  },
  "app": {
    "windows": [
      {
        "title": "vectors",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
