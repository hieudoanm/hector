{
  "info": {
    "name": "NEO Bank \u2014 Account Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Account Service. Manages accounts and balances. Validates account\nexistence/ownership, serves balance, executes debit/credit operations\nas part of the saga, and enforces non-negative balances. Owns accounts data.\n\nThis REST file covers the balance read endpoint only. The saga\ndebit/credit commands the service consumes and the result events it\nproduces are specified in the companion AsyncAPI file\n`account-service-asyncapi.yaml`.\n",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    }
  ],
  "item": [
    {
      "name": "GET /accounts/{accountId}/balance",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/accounts/{accountId}/balance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "accounts",
            ":accountId",
            "balance"
          ],
          "variable": [
            {
              "key": "accountId",
              "value": "e7f8a9b0-1c2d-4e5f-8a9b-0c1d2e3f4a5b"
            }
          ]
        },
        "description": "Get account balance",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [
        {
          "name": "200",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
